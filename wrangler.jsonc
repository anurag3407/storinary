{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.mjs",
	"name": "storinary",
	"compatibility_date": "2026-09-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "storinary.sayalabs.in",
			"custom_domain": true
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "storinary"
		}
	],
	"hyperdrive": [
		{
			// Hyperdrive holds the encrypted, pooled connection to Supabase; the
			// Worker never dials Postgres directly (see src/lib/prisma.ts).
			"binding": "HYPERDRIVE",
			"id": "0efb5bed1f5443ce96b13d113f92d77a",
			// Placeholder so `wrangler dev`/`deploy` do not require database
			// credentials. Point local development at a real database with
			// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, which
			// overrides this value (see CONTRIBUTING.md).
			"localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}