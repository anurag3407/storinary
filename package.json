{
  "name": "storinary",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "description": "Free, self-hosted Cloudinary alternative. Bulk upload, transform, and serve images from Supabase Storage.",
  "author": "Anurag <anurag3407> (https://github.com/anurag3407)",
  "keywords": [
    "image-cdn",
    "image-uploader",
    "cloudinary-alternative",
    "supabase",
    "nextjs",
    "image-transformation",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anurag3407/storinary-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/anurag3407/storinary-cloud/issues"
  },
  "homepage": "https://github.com/anurag3407/storinary-cloud#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:sdk": "npm run build --prefix packages/storinary",
    "test:watch": "vitest",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
