# ─── Database ───────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production / Vercel (PostgreSQL) — e.g. from Supabase or Neon:
# DATABASE_URL="postgresql://user:password@db.host:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://user:password@db.host:5432/postgres"   # optional, for pooled connections

# ─── Storage Provider (pick ONE) ────────────────────────────
# Storinary auto-detects the provider from the credentials you provide:
#   Backblaze B2  →  Appwrite Storage  →  Supabase Storage
# Only configure one block below, or set STORAGE_PROVIDER explicitly.
# STORAGE_PROVIDER="supabase"   # "backblaze" | "appwrite" | "supabase"

# ── Option A: Backblaze B2 (10 GB free) ─────────────────────
# Console → Application Keys. The bucket must be public.
# BACKBLAZE_APPLICATION_KEY_ID="your_backblaze_key_id"
# BACKBLAZE_APPLICATION_KEY="your_backblaze_application_key"
# BACKBLAZE_BUCKET_NAME="storinary"
# BACKBLAZE_BUCKET_ID="your_bucket_id"                 # optional, auto-resolved
# NEXT_PUBLIC_BACKBLAZE_CDN_URL="https://f000.backblazeb2.com"   # optional custom CDN

# ── Option B: Appwrite Storage (Student Offer / Cloud) ──────
# Console → Settings / API Keys / Storage. Bucket permissions must allow public reads.
# NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
# NEXT_PUBLIC_APPWRITE_PROJECT_ID="your_appwrite_project_id"
# APPWRITE_API_KEY="your_secret_api_key_with_storage_scope"
# APPWRITE_BUCKET_ID="storinary"

# ── Option C: Supabase Storage ──────────────────────────────
# Dashboard → Project Settings → API / Storage. Bucket must exist and be public.
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"        # or the new publishable key
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"    # server-side only, never expose
# SUPABASE_BUCKET_NAME="storinary"

# ─── Authentication ─────────────────────────────────────────
# Storinary ships with Better Auth (email + password, multi-tenant workspaces).
# This is the default and needs no third-party account — great for self-hosting.
#
# Required secret: any random string of at least 32 characters.
# Generate one with:  openssl rand -base64 48
BETTER_AUTH_SECRET="change-this-to-a-random-string-of-at-least-32-chars"

# Optional: use Clerk instead of Better Auth. Set isclerk=true and add the keys.
# Clerk is what the hosted demo uses; Better Auth is recommended for self-hosting.
isclerk=false
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
# CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ─── Transactional Email (optional in development) ──────────
# Signup, password reset, and invitations send email. In development, if no
# provider is configured the message (including the verification link) is
# printed to the server console instead, so you can get started with zero setup.
#
# Set isresend=true to deliver through Resend:
isresend=false
# RESEND_API_KEY="re_your_resend_api_key"
# RESEND_FROM="Storinary <onboarding@resend.dev>"

# …or set isresend=false and fill in SMTP (any provider, e.g. Mailgun/Postmark):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-user"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="Storinary <no-reply@yourdomain.com>"

# ─── App Settings ───────────────────────────────────────────
# Public origin of this deployment. Used for generated links, emails, and
# auth callbacks — set it to the exact HTTPS origin in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: custom CDN domain used for delivery URLs (defaults to the app URL).
# STORINARY_CDN_URL="https://cdn.yourdomain.com"
NEXT_PUBLIC_MAX_FILE_SIZE_MB="10"
NEXT_PUBLIC_ALLOWED_FORMATS="image/jpeg,image/png,image/webp,image/gif,image/avif,image/svg+xml"

# Optional: enable expiring, HMAC-signed image/video delivery.
# STORINARY_SIGNED_URL_SECRET="another-unique-random-secret"

# ─── Cloudinary Migration (optional — only if migrating) ─────
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ─── Optional Server-side Vision AI (OpenAI-compatible) ─────
# STORINARY_AI_API_KEY="your-provider-api-key"
# STORINARY_AI_BASE_URL="https://api.openai.com/v1"
# STORINARY_AI_MODEL="gpt-4o-mini"
# STORINARY_AI_ENABLE_TAGS="true"
# STORINARY_AI_ENABLE_CAPTIONS="true"
# STORINARY_AI_ENABLE_MODERATION="true"
