# ─── Database ───────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production / Vercel (PostgreSQL) — e.g. from Supabase or Neon:
# DATABASE_URL="postgresql://user:password@db.host:5432/postgres?sslmode=require"

# ─── Storage Provider Configuration ─────────────────────────
# Optional explicit provider selection: "backblaze" | "appwrite" | "supabase"
# Auto-detection precedence if STORAGE_PROVIDER is unset:
# 1. Backblaze B2 (first priority if BACKBLAZE keys are present)
# 2. Appwrite Storage (second priority if APPWRITE keys are present)
# 3. Supabase Storage (third priority fallback)
# STORAGE_PROVIDER="backblaze"

# ─── Backblaze B2 Cloud Storage (10 GB Free Storage) ────────
# Get from: Backblaze B2 Console (backblaze.com/b2) → Buckets & App Keys
BACKBLAZE_APPLICATION_KEY_ID="your_backblaze_key_id"
BACKBLAZE_APPLICATION_KEY="your_backblaze_application_key"
BACKBLAZE_BUCKET_NAME="storinary"
# Optional: explicitly provide Bucket ID if known (otherwise auto-detected)
# BACKBLAZE_BUCKET_ID="your_bucket_id"
# Optional: custom CDN domain or endpoint
# NEXT_PUBLIC_BACKBLAZE_CDN_URL="https://f000.backblazeb2.com"

# ─── Appwrite Storage (Student Offer / Pro / Cloud) ─────────
# Get from: Appwrite Console (cloud.appwrite.io) → Settings / API Keys / Storage
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="your_appwrite_project_id"
APPWRITE_API_KEY="your_secret_api_key_with_storage_scope"
APPWRITE_BUCKET_ID="storinary"

# ─── Supabase Storage ───────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API / Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_BUCKET_NAME="storinary"

# ─── Authentication Provider (Clerk vs Better Auth) ────────
# Set isclerk=true for Clerk authentication, or false for Better Auth.
isclerk=true
# Clerk configuration (required when isclerk=true):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Better Auth configuration (used when isclerk=false):
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# ─── Email Provider (Resend vs SMTP) ────────────────────────
# Set isresend=true to deliver transactional emails via Resend.
# Set isresend=false (or leave unset) to deliver via standard SMTP.
isresend=true
# Resend configuration (used when isresend=true):
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Storinary <onboarding@resend.dev>"

# SMTP configuration (used when isresend=false):
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Storinary <no-reply@example.com>"

# Optional private delivery. When set, /api/serve URLs require signed tokens.
# STORINARY_SIGNED_URL_SECRET="replace-with-an-independent-random-secret"

# ─── Cloudinary Migration (optional — only needed if migrating) ──
# Find these at Cloudinary Dashboard → Account → API Keys (or Settings → API Keys)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── App Settings ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MAX_FILE_SIZE_MB="10"
NEXT_PUBLIC_ALLOWED_FORMATS="image/jpeg,image/png,image/webp,image/gif,image/avif,image/svg+xml"

# ─── Optional Server-side Vision AI (OpenAI-compatible) ─────
# STORINARY_AI_API_KEY="your-provider-api-key"
# STORINARY_AI_BASE_URL="https://api.openai.com/v1"
# STORINARY_AI_MODEL="gpt-4o-mini"
# STORINARY_AI_ENABLE_TAGS="true"
# STORINARY_AI_ENABLE_CAPTIONS="true"
# STORINARY_AI_ENABLE_MODERATION="true"
