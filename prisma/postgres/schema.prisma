// ─────────────────────────────────────────────────────────────────────────────
// PRODUCTION / SERVERLESS SCHEMA (PostgreSQL)
// ─────────────────────────────────────────────────────────────────────────────
// This schema is used for Postgres deployments (Vercel, Render, Fly, etc.).
// SQLite is used for local development via `prisma/schema.prisma`.
//
// ⚠️  KEEP THIS FILE IN SYNC WITH `prisma/schema.prisma` — the two schemas
//     define the same `Image` model. When you change one, change the other
//     (the CI workflow validates both).
//
// Prisma resolves the migrations directory NEXT TO each schema file, so the
// Postgres schema lives in its own folder (`prisma/postgres/`) with its own
// `migrations/`. Do NOT rename this file or move it into `prisma/` — the
// SQLite and Postgres migration histories would collide.
//
// Usage:
//   npx prisma migrate dev    --schema prisma/postgres/schema.prisma   # dev against Postgres
//   npx prisma migrate deploy --schema prisma/postgres/schema.prisma   # apply on deploy
//   npx prisma generate       --schema prisma/postgres/schema.prisma   # generate client
//
// ⚠️  Generating the client with this schema switches @prisma/client to the
//     Postgres engine. On the Vercel build host that is intended; if you run
//     it locally, restore your dev client afterwards with `npx prisma generate`.
//
// DATABASE_URL must point at a PostgreSQL connection string, e.g.
//   postgresql://user:pass@host:5432/db?sslmode=require

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Image {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id String @id @default(cuid())

  // ── File Info ──────────────────────────────────
  originalName String // Original filename from user (e.g., "photo.jpg")
  storagePath  String @unique // Supabase Storage path (e.g., "2024/08/photo-abc12345.webp")
  publicUrl    String // Full public URL (e.g., "https://<ref>.supabase.co/storage/v1/object/public/storinary/2024/08/photo-abc12345.webp")

  // ── Image Metadata ─────────────────────────────
  width    Int // Width in pixels
  height   Int // Height in pixels
  fileSize Int // Size in bytes
  format   String // "jpeg", "png", "webp", "avif", "gif", "svg"
  mimeType String // "image/jpeg", "image/png", etc.

  // ── Organization ───────────────────────────────
  folder  String @default("/") // Virtual folder path (e.g., "/products", "/blog")
  tags    String @default("") // Comma-separated tags (e.g., "hero,banner,product")
  altText String @default("") // Alt text for accessibility

  // ── Processing Flags ───────────────────────────
  bgRemoved         Boolean @default(false) // Was background removal applied?
  compressed        Boolean @default(false) // Was client-side compression applied?
  aiModerated       Boolean @default(false)
  aiModerationScore Float?

  // ── Timestamps ─────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections    CollectionItem[]
  deliveryEvents DeliveryEvent[]
  versions       ImageVersion[]
  aiInsights     AiInsight[]
  metadata       StructuredMetadata[]

  // ── Indexes ────────────────────────────────────
  @@index([folder])
  @@index([createdAt])
  @@index([originalName])
  @@index([organizationId])
  @@unique([organizationId, storagePath])
}

model ImageVersion {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  imageId      String
  version      Int
  label        String   @default("original")
  originalName String
  storagePath  String
  publicUrl    String
  width        Int
  height       Int
  fileSize     Int
  format       String
  mimeType     String
  createdAt    DateTime @default(now())

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([imageId, version])
  @@index([imageId, createdAt])
  @@index([organizationId])
  @@unique([organizationId, storagePath])
  @@unique([organizationId, imageId, version])
}

model AiInsight {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id              String   @id @default(cuid())
  kind            String
  provider        String   @default("openai-compatible")
  model           String
  tags            String   @default("")
  altText         String?
  moderationScore Float?
  isSafe          Boolean?
  rawMetadata     String?
  createdAt       DateTime @default(now())

  imageId String?
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([imageId, createdAt])
  @@index([kind, createdAt])
  @@index([organizationId])
}

model ApiKey {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id         String    @id @default(cuid())
  name       String
  hashedKey  String    @unique
  keyPrefix  String
  lastFour   String
  scopes     String    @default("upload,read")
  unsigned   Boolean   @default(false)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  usageEvents ApiKeyUsageEvent[]

  @@index([keyPrefix])
  @@index([organizationId])
}

model ApiKeyUsageEvent {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  apiKeyId    String
  periodStart DateTime
  action      String
  requests    Int      @default(0)
  assets      Int      @default(0)
  errors      Int      @default(0)
  bytes       BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, periodStart, action])
  @@index([periodStart])
  @@index([organizationId])
  @@unique([organizationId, apiKeyId, periodStart, action])
}

model Video {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id           String             @id @default(cuid())
  originalName String
  storagePath  String
  publicUrl    String
  mimeType     String
  posterPath   String?
  format       String
  width        Int
  height       Int
  duration     Float
  fileSize     Int
  folder       String             @default("/")
  tags         String             @default("")
  altText      String             @default("")
  aiModerated       Boolean     @default(false)
  aiModerationScore Float?
  status       String             @default("ready")
  renditions   VideoRendition[]
  hlsPackages  VideoHlsPackage[]
  dashPackages VideoDashPackage[]
  clips        VideoClip[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  collections    CollectionItem[]
  deliveryEvents DeliveryEvent[]
  versions       VideoVersion[]
  aiInsights     AiInsight[]
  metadata       StructuredMetadata[]

  @@index([folder])
  @@index([createdAt])
  @@index([originalName])
  @@index([organizationId])
  @@unique([organizationId, storagePath])
}

model VideoClip {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  videoId      String
  name         String
  storagePath  String
  publicUrl    String
  mimeType     String   @default("video/mp4")
  startSeconds Float
  endSeconds   Float
  muted        Boolean  @default(false)
  sourceLabel  String?
  fileSize     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, name])
  @@index([videoId, createdAt])
  @@index([organizationId])
  @@unique([organizationId, storagePath])
  @@unique([organizationId, videoId, name])
}

model VideoVersion {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  videoId      String
  version      Int
  label        String   @default("original")
  originalName String
  storagePath  String
  publicUrl    String
  mimeType     String
  posterPath   String?
  format       String
  width        Int
  height       Int
  duration     Float
  fileSize     Int
  createdAt    DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, version])
  @@index([videoId, createdAt])
  @@index([organizationId])
  @@unique([organizationId, storagePath])
  @@unique([organizationId, videoId, version])
}

model VideoHlsPackage {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  videoId       String
  label         String
  masterPath    String
  publicUrl     String
  variants      Json
  segmentPaths  Json
  totalFileSize Int
  status        String   @default("ready")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, label])
  @@index([videoId])
  @@index([organizationId])
  @@unique([organizationId, masterPath])
  @@unique([organizationId, videoId, label])
}

model VideoDashPackage {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  videoId       String
  label         String
  manifestPath  String
  publicUrl     String
  variants      Json
  filePaths     Json
  totalFileSize Int
  status        String   @default("ready")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, label])
  @@index([videoId])
  @@index([organizationId])
  @@unique([organizationId, manifestPath])
  @@unique([organizationId, videoId, label])
}

model VideoRendition {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  videoId     String
  label       String
  storagePath String
  publicUrl   String
  width       Int
  height      Int
  bitrateKbps Int
  fileSize    Int
  status      String   @default("ready")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, label])
  @@index([videoId])
  @@index([organizationId])
  @@unique([organizationId, storagePath])
}

model WebhookEndpoint {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([active])
  @@index([organizationId])
}

model WebhookDelivery {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id            String    @id @default(cuid())
  endpointId    String
  eventType     String
  payload       String
  status        String    @default("pending")
  responseCode  Int?
  attempts      Int       @default(0)
  error         String?
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([organizationId])
}

model UploadPreset {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  name         String
  resourceType String   @default("image")
  folder       String   @default("/")
  tags         String   @default("")
  compress     Boolean  @default(true)
  quality      Int      @default(80)
  maxWidth     Int      @default(2048)
  removeBg     Boolean  @default(false)
  moderate     Boolean  @default(false)
  renditions   Boolean  @default(false)
  active       Boolean  @default(true)
  unsigned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([organizationId])
  @@unique([organizationId, name])
}

model NamedTransformation {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  name      String
  params    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId])
  @@unique([organizationId, name])
}

model Collection {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id          String           @id @default(cuid())
  name        String
  description String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]
  @@index([organizationId])
  @@unique([organizationId, name])
}

model CollectionItem {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id           String  @id @default(cuid())
  collectionId String
  imageId      String?
  videoId      String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  image      Image?     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  video      Video?     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([organizationId])
}

model DeliveryEvent {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  imageId   String?
  videoId   String?
  rendition String?
  kind      String
  bytes     Int      @default(0)
  referer   String?
  userAgent String?
  createdAt DateTime @default(now())

  image Image? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  video Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([imageId, createdAt])
  @@index([videoId, createdAt])
  @@index([organizationId])
}

model MetadataField {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  externalId    String
  label         String
  type          String
  required      Boolean  @default(false)
  allowedValues String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  values StructuredMetadata[]
  @@index([organizationId])
  @@unique([organizationId, externalId])
}

model StructuredMetadata {
  organizationId String   @default("legacy")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id      String @id @default(cuid())
  fieldId String
  value   String @default("")
  imageId String?
  videoId String?

  field MetadataField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  image Image?        @relation(fields: [imageId], references: [id], onDelete: Cascade)
  video Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([fieldId, imageId])
  @@unique([fieldId, videoId])
  @@index([imageId])
  @@index([videoId])
  @@index([organizationId])
  @@unique([organizationId, fieldId, imageId])
  @@unique([organizationId, fieldId, videoId])
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}
model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
  images Image[]
  imageVersions ImageVersion[]
  aiInsights AiInsight[]
  apiKeys ApiKey[]
  apiKeyUsageEvents ApiKeyUsageEvent[]
  videos Video[]
  videoClips VideoClip[]
  videoVersions VideoVersion[]
  videoHlsPackages VideoHlsPackage[]
  videoDashPackages VideoDashPackage[]
  videoRenditions VideoRendition[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  uploadPresets UploadPreset[]
  namedTransformations NamedTransformation[]
  collections Collection[]
  collectionItems CollectionItem[]
  deliveryEvents DeliveryEvent[]
  metadataFields MetadataField[]
  structuredMetadata StructuredMetadata[]
}
model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}
model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
